# Backend API URL used by next.config.js rewrites (server-side proxy).
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Stripe PUBLISHABLE key (safe for the browser — never put the secret key here).
# Get this from the same Stripe dashboard as your backend's STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
